# Normalize line endings: store as LF in the repo, check out as-is.
# Stops the recurring LF<->CRLF "phantom" diffs on CEP source files.
* text=auto eol=lf

# Binary assets (never normalize)
*.png binary
*.zip binary
*.node binary
*.map binary

# Windows batch files need CRLF (label lookups break with LF)
*.bat text eol=crlf
